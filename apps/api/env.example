# MyMarketing API - Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores

# Ambiente
NODE_ENV=development
PORT=3333
WEB_ORIGIN=http://localhost:3000

# Supabase (obrigatório)
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key

# Armazenamento local de uploads
UPLOAD_DIR=./public/uploads/videos
MAX_UPLOAD_SIZE_MB=2048

# Google / YouTube OAuth (obrigatório em produção)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3333/api/channels/youtube/callback

# Chave de criptografia para refresh tokens (32 bytes = 64 chars hex)
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=